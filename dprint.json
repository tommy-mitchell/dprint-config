{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"includes": ["*.json", ".github/workflows/*.yml", "test/test.js", "readme.md"],
	"excludes": ["test/fixtures"],
	"extends": ["src/index.json", "src/malva.json", "src/markup.json"],
	"plugins": [
		"npm:@dprint/json@0.25.1",
		"npm:@dprint/typescript@0.96.1",
		"npm:@dprint/markdown@0.24.0",
		"npm:dprint-plugin-malva@0.16.0",
		"npm:dprint-plugin-yaml@0.6.0",
		"npm:dprint-plugin-markup@0.27.5",
	],
	"json": {
		"packageJson.applyConventions": true,
		"jsonTrailingCommaFiles": ["dprint.json", "src/*.json"],
	},
}
