{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"excludes": [
		"**/node_modules",
		"**/package-lock.json",
		"**/yarn.lock",
		"**/pnpm-lock.yaml",
		"**/bun.lock",
		"**/deno.lock",
	],
	"lineWidth": 120,
	"useTabs": true,
	"json": {
		"trailingCommas": "jsonc",
		"jsonTrailingCommaFiles": ["dprint.json", "{js,ts}config.*.json", ".vscode/*.json"],
		"packageJson.applyConventions": false,
		"array.preferSingleLine": true,
		"overrides": [{
			"files": ["package.json"],
			"array.preferSingleLine": false,
		}],
	},
	"markdown": {
		"emphasisKind": "asterisks",
		"overrides": [{
			"files": "readme.md",
			"codeBlock.skipFormat": true,
		}],
	},
	"typescript": {
		"semiColons": "always",
		"quoteProps": "consistent",
		"useBraces": "always",
		"bracePosition": "sameLine",
		"singleBodyPosition": "nextLine",
		"nextControlFlowPosition": "maintain",
		"trailingCommas": "onlyMultiLine",
		"arrowFunction.useParentheses": "maintain",
		"typeAssertion.spaceBeforeExpression": false,
		"jsx.multiLineParens": "prefer",
		"unionAndIntersectionType.preferSingleLine": true,
		"module.sortImportDeclarations": "maintain",
		"module.sortExportDeclarations": "maintain",
	},
	"yaml": {
		"formatComments": true,
		"ignoreCommentDirective": "dprint-ignore",
	},
}
